<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestionstock.controller.CategorieController"
      spacing="10.0">
    <padding>
        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
    </padding>
    <children>
        <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#ouvrirDialogueAjout" prefWidth="90.0" text="Ajouter" />
                <Button fx:id="boutonModifier" mnemonicParsing="false" onAction="#ouvrirDialogueModification" prefWidth="90.0" text="Modifier" />
                <Button fx:id="boutonSupprimer" mnemonicParsing="false" onAction="#supprimerCategorie" prefWidth="90.0" text="Supprimer" />
            </children>
        </HBox>
        <TableView fx:id="tableCategories" prefWidth="640.0">
            <columns>
                <TableColumn fx:id="colonneNom" prefWidth="200.0" text="Nom" />
                <TableColumn fx:id="colonneDescription" prefWidth="300.0" text="Description" />
                <TableColumn fx:id="colonneNbProduits" prefWidth="140.0" text="Nb. produits" />
            </columns>
        </TableView>
    </children>
</VBox>