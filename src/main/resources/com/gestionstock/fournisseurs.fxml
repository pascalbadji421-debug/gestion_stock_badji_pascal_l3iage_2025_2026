<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestionstock.controller.FournisseurController">
    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0" />
    </padding>
    <children>
        <HBox spacing="10.0" alignment="CENTER_RIGHT">
            <children>
                <Button text="Ajouter" onAction="#ouvrirDialogueAjout" />
                <Button text="Modifier" onAction="#ouvrirDialogueModification" />
                <Button text="Supprimer" onAction="#supprimerFournisseur" />
            </children>
        </HBox>

        <TableView fx:id="tableFournisseurs" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colonneNom" text="Nom" prefWidth="200.0" />
                <TableColumn fx:id="colonneEmail" text="Email" prefWidth="200.0" />
                <TableColumn fx:id="colonneTel" text="Telephone" prefWidth="150.0" />
            </columns>
        </TableView>
    </children>
</VBox>